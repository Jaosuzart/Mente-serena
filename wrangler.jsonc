{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mente-serena-web",
  "main": "src/cloudflare-worker.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./src/frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/create_preference",
      "/create_preference/*",
      "/validar_cupom",
      "/validar_cupom/*",
      "/claim_free_spot",
      "/claim_free_spot/*",
      "/webhook",
      "/webhook/*",
      "/api/*"
    ]
  },
  "vars": {
    "BACKEND_URL": "https://mente-serena.onrender.com"
  }
}
