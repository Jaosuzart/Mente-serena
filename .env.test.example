# Copie para .env.test.local e use SOMENTE contas e banco de teste.
# Não copie credenciais reais para este exemplo.
NODE_ENV=test
WHATSAPP_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_teste
DB_PASSWORD=
DB_NAME=mente_serena_test
DB_SSL=false
DB_CONN_LIMIT=2
DB_QUEUE_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
# Para banco hospedado que exige TLS, use DB_SSL=true.
# Token da conta VENDEDORA de teste do Mercado Pago:
MP_ACCESS_TOKEN=
# Para uma etapa posterior de compra de teste:
MP_TEST_BUYER_EMAIL=
MP_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
