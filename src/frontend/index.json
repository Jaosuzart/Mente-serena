    "content":  "\u003c!DOCTYPE html\u003e\r\n\u003chtml lang=\"pt-BR\"\u003e\r\n\u003chead\u003e\r\n    \u003cmeta charset=\"UTF-8\"\u003e\r\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\r\n    \u003cmeta name=\"description\" content=\"Aprenda estratégias práticas para desenvolver calma, resiliência, empatia e relacionamentos mais saudáveis com conteúdos inspirados em pesquisas de psicologia e neurociência.\"\u003e\r\n    \u003ctitle\u003eMente Serena | Neurociência, Resiliência e Relacionamentos\u003c/title\u003e\r\n    \r\n    \u003c!-- Google Fonts --\u003e\r\n    \u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\r\n    \u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin\u003e\r\n    \u003clink href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600\u0026family=Manrope:wght@600;700;800\u0026display=swap\" rel=\"stylesheet\" media=\"print\" onload=\"this.media=\u0027all\u0027\"\u003e\r\n    \u003cnoscript\u003e\u003clink href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600\u0026family=Manrope:wght@600;700;800\u0026display=swap\" rel=\"stylesheet\"\u003e\u003c/noscript\u003e\r\n    \r\n    \u003c!-- Bootstrap 5 CSS --\u003e\r\n    \u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\" rel=\"stylesheet\" media=\"print\" onload=\"this.media=\u0027all\u0027\"\u003e\r\n    \u003cnoscript\u003e\u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\" rel=\"stylesheet\"\u003e\u003c/noscript\u003e\r\n    \r\n    \u003c!-- Custom CSS --\u003e\r\n    \u003clink rel=\"stylesheet\" href=\"css/style.css\"\u003e\r\n\r\n    \u003c!-- Open Graph Meta Tags --\u003e\r\n    \u003cmeta property=\"og:title\" content=\"Mente Serena\"\u003e\r\n    \u003cmeta property=\"og:description\" content=\"Educação e desenvolvimento pessoal para relacionamentos melhores.\"\u003e\r\n    \u003cmeta property=\"og:type\" content=\"website\"\u003e\r\n    \u003cscript src=\"js/theme.js\"\u003e\u003c/script\u003e\n\u003c/head\u003e\r\n\u003cbody\u003e\n    \u003ca href=\"#main-content\" class=\"skip-link\"\u003ePular para o conte�do principal\u003c/a\u003e\r\n\r\n    \u003c!-- Navbar --\u003e\r\n    \u003cnav class=\"navbar navbar-expand-lg navbar-ms fixed-top\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003ca class=\"navbar-brand\" href=\"index.html\"\u003eMente Serena.\u003c/a\u003e\r\n            \u003cbutton class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarNav\" aria-controls=\"navbarNav\" aria-expanded=\"false\" aria-label=\"Alternar navegação\"\u003e\r\n                \u003cspan class=\"navbar-toggler-icon\"\u003e\u003c/span\u003e\r\n            \u003c/button\u003e\r\n            \u003cdiv class=\"collapse navbar-collapse justify-content-end\" id=\"navbarNav\"\u003e\r\n                \u003cul class=\"navbar-nav align-items-center\"\u003e\r\n                    \u003cli class=\"nav-item\"\u003e\u003ca class=\"nav-link\" href=\"#metodo\"\u003eO Método\u003c/a\u003e\u003c/li\u003e\r\n                    \u003cli class=\"nav-item\"\u003e\u003ca class=\"nav-link\" href=\"#modulos\"\u003eMódulos\u003c/a\u003e\u003c/li\u003e\r\n                    \u003cli class=\"nav-item\"\u003e\u003ca class=\"nav-link\" href=\"aulas.html\"\u003eÁrea de Membros\u003c/a\u003e\u003c/li\u003e\r\n                    \u003cli class=\"nav-item ms-lg-3\"\u003e\u003ca class=\"btn btn-ms-primary\" href=\"#cta\"\u003eComeçar agora\u003c/a\u003e\u003c/li\u003e\r\n                                    \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/nav\u003e\r\n\r\n    \u003c!-- 4. Hero / Primeira Dobra --\u003e\r\n    \u003cheader class=\"hero-section\"\u003e\n\u003cdiv id=\"main-content\" tabindex=\"-1\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"row align-items-center\"\u003e\r\n                \u003cdiv class=\"col-lg-6 mb-5 mb-lg-0 fade-in-up\"\u003e\r\n                    \u003ch1 class=\"hero-title\"\u003eAprenda a responder à vida com mais calma, consciência e equilíbrio.\u003c/h1\u003e\r\n                    \u003cp class=\"hero-subtitle\"\u003eUm curso prático sobre relacionamentos, comunicação, empatia e resiliência inspirado em conhecimentos da psicologia e da neurociência.\u003c/p\u003e\r\n                    \u003cdiv class=\"d-flex flex-column flex-sm-row gap-3\"\u003e\r\n                        \u003ca href=\"#cta\" class=\"btn btn-ms-primary\"\u003eComeçar o curso\u003c/a\u003e\r\n                        \u003ca href=\"#metodo\" class=\"btn btn-ms-secondary\"\u003eConhecer o método\u003c/a\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-lg-6 fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"hero-image-wrapper\"\u003e\r\n                        \u003c!-- Imagem elegante de comunicação serena --\u003e\r\n                        \u003cimg src=\"assets/images/hero.png\" alt=\"Duas pessoas conversando de forma calma e atenta\" class=\"img-fluid w-100\" style=\"object-fit: cover; height: 500px;\" width=\"800\" height=\"500\" fetchpriority=\"high\"\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/header\u003e\r\n\r\n    \u003c!-- Frase de Destaque --\u003e\r\n    \u003csection class=\"py-5 bg-light-ms\"\u003e\r\n        \u003cdiv class=\"container fade-in-up\"\u003e\r\n            \u003cp class=\"quote-highlight\"\u003e“Calma não é ausência de força.”\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 5. Seção \"Por que este curso?\" --\u003e\r\n    \u003csection class=\"py-5 my-5\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"row justify-content-center text-center mb-5 fade-in-up\"\u003e\r\n                \u003cdiv class=\"col-lg-8\"\u003e\r\n                    \u003ch2\u003eVocê não precisa ser perfeito. Precisa aprender a escolher suas respostas.\u003c/h2\u003e\r\n                    \u003cp class=\"mt-4\"\u003eEmoções fazem parte da experiência humana. O objetivo não é eliminar emoções negativas, mas sim criar um espaço seguro de decisão.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cdiv class=\"row align-items-center bg-white rounded-4 shadow-sm p-4 p-md-5 mx-0 fade-in-up\"\u003e\r\n                \u003cdiv class=\"col-md-5 text-center text-md-end border-end-md pe-md-5 mb-4 mb-md-0 text-muted\"\u003e\r\n                    \u003ch4 class=\"text-danger\"\u003eA Reação Impulsiva\u003c/h4\u003e\r\n                    \u003cp class=\"fs-5 mb-0\"\u003eSituação \u0026rarr; Impulso \u0026rarr; Reação\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-2 text-center fs-2 text-muted d-none d-md-block\"\u003eVS\u003c/div\u003e\r\n                \u003cdiv class=\"col-md-5 text-center text-md-start ps-md-5\"\u003e\r\n                    \u003ch4 class=\"text-success\"\u003eA Resposta Consciente\u003c/h4\u003e\r\n                    \u003cp class=\"fs-5 mb-0 fw-bold text-accent-ms\"\u003eSituação \u0026rarr; Emoção \u0026rarr; Resposta\u003c/p\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 6. Seção \"O que você vai aprender\" --\u003e\r\n    \u003csection class=\"py-5 bg-light-ms\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"text-center mb-5 fade-in-up\"\u003e\r\n                \u003ch2\u003eO que você vai aprender\u003c/h2\u003e\r\n                \u003cp class=\"text-muted\"\u003eHabilidades práticas para o dia a dia.\u003c/p\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"row g-4\"\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.1s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e🌬️\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eCalma\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eAprenda a fazer uma pausa antes de reagir.\u003c/strong\u003e Pratique estratégias simples de respiração, atenção e pausa consciente.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e💬\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eComunicação\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eFale com firmeza sem precisar agredir.\u003c/strong\u003e Aprenda princípios de comunicação assertiva e estabelecimento de limites.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.3s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e👂\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eEscuta ativa\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eAprenda a ouvir para compreender.\u003c/strong\u003e Pratique perguntas, confirmação de entendimento e atenção ao interlocutor.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.4s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e🤝\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eEmpatia\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eCompreenda sem abandonar seus próprios limites.\u003c/strong\u003e Aprenda a considerar a perspectiva do outro sem confundir empatia com concordância.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.5s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e🌱\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eResiliência\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eAtravesse dificuldades sem deixar que elas definam você.\u003c/strong\u003e Aprenda a concentrar sua atenção na próxima ação possível.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.6s;\"\u003e\r\n                    \u003cdiv class=\"ms-card\"\u003e\r\n                        \u003cdiv class=\"ms-card-icon\"\u003e🔍\u003c/div\u003e\r\n                        \u003ch3 class=\"ms-card-title\"\u003eAutoconhecimento\u003c/h3\u003e\r\n                        \u003cp\u003e\u003cstrong\u003eObserve seus padrões e aprenda com eles.\u003c/strong\u003e Utilize reflexão diária para identificar comportamentos impulsivos e oportunidades.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- Frase de Destaque --\u003e\r\n    \u003csection class=\"py-5\"\u003e\r\n        \u003cdiv class=\"container fade-in-up\"\u003e\r\n            \u003cp class=\"quote-highlight\"\u003e“Ouvir também é uma forma de cuidar.”\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 7. Seção \"Como a neurociência entra no curso\" --\u003e\r\n    \u003csection class=\"neuro-section\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"row justify-content-center text-center mb-5 fade-in-up\"\u003e\r\n                \u003cdiv class=\"col-lg-8\"\u003e\r\n                    \u003ch2\u003eCiência para compreender o comportamento.\u003cbr\u003ePrática para transformar hábitos.\u003c/h2\u003e\r\n                    \u003cp class=\"mt-4\"\u003ePesquisas em neurociência social, regulação emocional e resiliência ajudam a compreender como emoções, atenção, controle executivo, percepção social e relações interpessoais estão conectados.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"row mt-5\"\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\"\u003e\r\n                    \u003cdiv class=\"neuro-block\"\u003e\r\n                        \u003ch3 class=\"h4\"\u003eRegulação emocional\u003c/h3\u003e\r\n                        \u003cp\u003eComo reconhecer emoções e criar espaço estruturado para respostas mais conscientes e adequadas ao contexto.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"neuro-block\"\u003e\r\n                        \u003ch3 class=\"h4\"\u003eCognição social\u003c/h3\u003e\r\n                        \u003cp\u003eComo compreender melhor pensamentos, perspectivas e comportamentos de outras pessoas nas interações diárias.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.4s;\"\u003e\r\n                    \u003cdiv class=\"neuro-block\"\u003e\r\n                        \u003ch3 class=\"h4\"\u003eResiliência\u003c/h3\u003e\r\n                        \u003cp\u003eComo processos psicológicos e sociais podem contribuir positivamente para enfrentar adversidades.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"text-center mt-5 fade-in-up\"\u003e\r\n                \u003ca href=\"referencias.html\" class=\"text-white text-decoration-underline\"\u003eConheça os estudos baseados em pesquisas\u003c/a\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 9. Seção \"O Método\" --\u003e\r\n    \u003csection id=\"metodo\" class=\"py-5 my-5\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"text-center mb-5 fade-in-up\"\u003e\r\n                \u003ch2\u003eUma metodologia simples para situações reais.\u003c/h2\u003e\r\n                \u003cp class=\"quote-highlight mt-4 fs-4\" style=\"color: var(--ms-verde-suave);\"\u003e“Você não controla todas as situações. Mas pode treinar a forma como responde a elas.”\u003c/p\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cdiv class=\"row g-4 mt-4\"\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e01\u003c/div\u003e\r\n                    \u003ch4\u003ePare\u003c/h4\u003e\r\n                    \u003cp\u003eNão responda imediatamente. Ganhe alguns segundos.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\" style=\"transition-delay: 0.1s;\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e02\u003c/div\u003e\r\n                    \u003ch4\u003eRespire\u003c/h4\u003e\r\n                    \u003cp\u003eDiminua o ritmo fisiológico da reação inicial.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e03\u003c/div\u003e\r\n                    \u003ch4\u003eObserve\u003c/h4\u003e\r\n                    \u003cp\u003eIdentifique o que está sentindo sem julgamentos.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\" style=\"transition-delay: 0.3s;\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e04\u003c/div\u003e\r\n                    \u003ch4\u003eEntenda\u003c/h4\u003e\r\n                    \u003cp\u003eSepare fatos puros de interpretações e emoções.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\" style=\"transition-delay: 0.4s;\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e05\u003c/div\u003e\r\n                    \u003ch4\u003eEscolha\u003c/h4\u003e\r\n                    \u003cp\u003eDecida qual resposta está verdadeiramente de acordo com seus valores.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-4 method-step fade-in-up\" style=\"transition-delay: 0.5s;\"\u003e\r\n                    \u003cdiv class=\"method-number\"\u003e06\u003c/div\u003e\r\n                    \u003ch4\u003eAja\u003c/h4\u003e\r\n                    \u003cp\u003eComunique-se de forma construtiva, com respeito e firmeza.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 10. Módulos do Curso --\u003e\r\n    \u003csection id=\"modulos\" class=\"py-5 bg-light-ms border-top\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"text-center mb-5 fade-in-up\"\u003e\r\n                \u003ch2\u003eMódulos do Curso\u003c/h2\u003e\r\n                \u003cp class=\"text-muted\"\u003eUma jornada estruturada para desenvolvimento contínuo.\u003c/p\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"row g-4\"\u003e\r\n                \u003c!-- Mod 1 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 1\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eA pausa consciente\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Impulso x resposta\u003c/li\u003e\r\n                            \u003cli\u003e✓ Como criar uma pausa\u003c/li\u003e\r\n                            \u003cli\u003e✓ Respiração\u003c/li\u003e\r\n                            \u003cli\u003e✓ Regra dos 10 segundos\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 2 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.1s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 2\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eCalma não é fraqueza\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Assertividade\u003c/li\u003e\r\n                            \u003cli\u003e✓ Limites\u003c/li\u003e\r\n                            \u003cli\u003e✓ Comunicação firme\u003c/li\u003e\r\n                            \u003cli\u003e✓ Evitar humilhações\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 3 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 3\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eEscuta ativa\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Ouvir para compreender\u003c/li\u003e\r\n                            \u003cli\u003e✓ Perguntas abertas\u003c/li\u003e\r\n                            \u003cli\u003e✓ Confirmar entendimento\u003c/li\u003e\r\n                            \u003cli\u003e✓ Evitar interromper\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 4 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.3s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 4\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eEmpatia\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Perspectiva do outro\u003c/li\u003e\r\n                            \u003cli\u003e✓ Compreensão sem concordância\u003c/li\u003e\r\n                            \u003cli\u003e✓ Empatia com limites\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 5 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.4s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 5\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eResiliência\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ O que é resiliência\u003c/li\u003e\r\n                            \u003cli\u003e✓ Adversidades\u003c/li\u003e\r\n                            \u003cli\u003e✓ Próxima ação possível\u003c/li\u003e\r\n                            \u003cli\u003e✓ Aprender com dificuldades\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 6 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.5s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 6\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eRelações saudáveis\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Respeito\u003c/li\u003e\r\n                            \u003cli\u003e✓ Confiança\u003c/li\u003e\r\n                            \u003cli\u003e✓ Comunicação\u003c/li\u003e\r\n                            \u003cli\u003e✓ Limites \u0026 Reciprocidade\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 7 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.6s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 7\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eAutoconhecimento\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Reflexão diária\u003c/li\u003e\r\n                            \u003cli\u003e✓ Identificação de padrões\u003c/li\u003e\r\n                            \u003cli\u003e✓ Responsabilidade pessoal\u003c/li\u003e\r\n                            \u003cli\u003e✓ Mudança gradual\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003c!-- Mod 8 --\u003e\r\n                \u003cdiv class=\"col-md-6 col-lg-3 fade-in-up\" style=\"transition-delay: 0.7s;\"\u003e\r\n                    \u003cdiv class=\"ms-card p-4\"\u003e\r\n                        \u003ch5 class=\"text-primary-ms mb-3\"\u003eMódulo 8\u003cbr\u003e\u003cspan class=\"fs-4\"\u003eA pessoa melhor\u003c/span\u003e\u003c/h5\u003e\r\n                        \u003cul class=\"list-unstyled text-muted mb-0\"\u003e\r\n                            \u003cli\u003e✓ Respeito\u003c/li\u003e\r\n                            \u003cli\u003e✓ Honestidade\u003c/li\u003e\r\n                            \u003cli\u003e✓ Responsabilidade\u003c/li\u003e\r\n                            \u003cli\u003e✓ Bondade sem submissão\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- Frase de Destaque --\u003e\r\n    \u003csection class=\"py-5\"\u003e\r\n        \u003cdiv class=\"container fade-in-up\"\u003e\r\n            \u003cp class=\"quote-highlight\"\u003e“Empatia não significa concordar com tudo. Limites também fazem parte de relacionamentos saudáveis.”\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 12. Exercícios Práticos --\u003e\r\n    \u003csection class=\"py-5 my-4 bg-primary-ms text-white rounded-4 mx-3 mx-md-5\"\u003e\r\n        \u003cdiv class=\"container py-4\"\u003e\r\n            \u003cdiv class=\"text-center mb-5 fade-in-up\"\u003e\r\n                \u003ch2 class=\"text-white\"\u003eAprenda praticando\u003c/h2\u003e\r\n                \u003cp class=\"text-white-50\"\u003eO conhecimento ganha força através da ação repetida.\u003c/p\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"row g-4\"\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\"\u003e\r\n                    \u003cdiv class=\"p-4 bg-white rounded-3 text-dark h-100\"\u003e\r\n                        \u003ch4 class=\"text-primary-ms\"\u003eExercício 1 — Pausa de 10 segundos\u003c/h4\u003e\r\n                        \u003cp class=\"text-muted mt-3 mb-0\"\u003eQuando perceber que está prestes a responder impulsivamente, aguarde alguns segundos, respire e escolha conscientemente as palavras.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.2s;\"\u003e\r\n                    \u003cdiv class=\"p-4 bg-white rounded-3 text-dark h-100\"\u003e\r\n                        \u003ch4 class=\"text-primary-ms\"\u003eExercício 2 — Escuta ativa\u003c/h4\u003e\r\n                        \u003cp class=\"text-muted mt-3 mb-0\"\u003eDurante uma conversa, tente compreender completamente o que a outra pessoa está dizendo antes de formular sua resposta.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-4 fade-in-up\" style=\"transition-delay: 0.4s;\"\u003e\r\n                    \u003cdiv class=\"p-4 bg-white rounded-3 text-dark h-100\"\u003e\r\n                        \u003ch4 class=\"text-primary-ms\"\u003eExercício 3 — Diário de reflexão\u003c/h4\u003e\r\n                        \u003cul class=\"text-muted mt-3 mb-0 ps-3\"\u003e\r\n                            \u003cli\u003eOnde fui paciente hoje?\u003c/li\u003e\r\n                            \u003cli\u003eOnde reagi por impulso?\u003c/li\u003e\r\n                            \u003cli\u003eO que eu poderia fazer diferente?\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 14. Seção \"Para quem é\" e 15. \"O que não é\" --\u003e\r\n    \u003csection class=\"py-5 my-5\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"row g-5 align-items-center\"\u003e\r\n                \u003cdiv class=\"col-lg-6 fade-in-up\"\u003e\r\n                    \u003ch2 class=\"mb-4\"\u003eEste curso é para você se...\u003c/h2\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eVocê quer melhorar seus relacionamentos.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eÀs vezes reage no impulso.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eQuer aprender a conversar melhor em situações difíceis.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eDeseja desenvolver mais calma e empatia genuína.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eQuer aprender a estabelecer limites respeitosos.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"checklist-item\"\u003e\r\n                        \u003cspan class=\"checklist-icon\"\u003e✓\u003c/span\u003e\r\n                        \u003cp class=\"mb-0\"\u003eQuer trabalhar continuamente no próprio comportamento.\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-lg-6 fade-in-up\" style=\"transition-delay: 0.3s;\"\u003e\r\n                    \u003cdiv class=\"transparency-box\"\u003e\r\n                        \u003ch3 class=\"h4 mb-4\"\u003eO que este curso NÃO é\u003c/h3\u003e\r\n                        \u003cul class=\"text-muted mb-4 ps-3\"\u003e\r\n                            \u003cli\u003eTerapia, tratamento médico ou diagnóstico psicológico;\u003c/li\u003e\r\n                            \u003cli\u003ePromessa de transformação instantânea e mágica;\u003c/li\u003e\r\n                            \u003cli\u003eFórmula para controlar outras pessoas;\u003c/li\u003e\r\n                            \u003cli\u003eMétodo para eliminar emoções negativas.\u003c/li\u003e\r\n                                            \u003cli class=\"nav-item ms-lg-3\"\u003e\n                        \u003cbutton id=\"theme-toggle\" class=\"theme-toggle-btn\" aria-label=\"Alternar tema de cores\"\u003e\n                            \u003cspan id=\"theme-icon\"\u003e\u003c/span\u003e\n                        \u003c/button\u003e\n                    \u003c/li\u003e\n                \u003c/ul\u003e\r\n                        \u003cp class=\"fst-italic text-secondary-ms fw-semibold mb-0\"\u003e“O objetivo é educação e desenvolvimento de habilidades. Mudanças comportamentais acontecem gradualmente e podem variar de pessoa para pessoa.”\u003c/p\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- 16. CTA Final --\u003e\r\n    \u003csection id=\"cta\" class=\"container fade-in-up\"\u003e\r\n        \u003cdiv class=\"cta-section\"\u003e\r\n            \u003ch2 class=\"display-5 fw-bold mb-3\"\u003eComece a construir respostas mais conscientes.\u003c/h2\u003e\r\n            \u003ch3 class=\"h4 fw-normal text-white-50 mb-4\"\u003eRespire. Pense. Escolha. Continue.\u003c/h3\u003e\r\n            \u003cp class=\"lead text-white-50 mx-auto mb-5\" style=\"max-width: 600px;\"\u003eRelacionamentos melhores começam quando aprendemos a cuidar das pessoas sem deixar de cuidar de nós mesmos.\u003c/p\u003e\r\n            \u003ca href=\"aulas.html\" class=\"btn btn-ms-cta btn-lg px-5 py-3\"\u003eComeçar agora\u003c/a\u003e\r\n            \u003cp class=\"mt-4 text-white-50 small\"\u003eAcesso imediato à plataforma de ensino.\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- Footer --\u003e\r\n    \u003cfooter class=\"footer-ms\"\u003e\r\n        \u003cdiv class=\"container\"\u003e\r\n            \u003cdiv class=\"row text-center text-md-start\"\u003e\r\n                \u003cdiv class=\"col-md-4 mb-4 mb-md-0\"\u003e\r\n                    \u003ch4 class=\"text-primary-ms fw-bold\"\u003eMente Serena.\u003c/h4\u003e\r\n                    \u003cp class=\"text-muted small mt-2\"\u003eEducação e desenvolvimento pessoal fundamentado na ciência para uma vida com mais consciência.\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"col-md-2 offset-md-2 mb-4 mb-md-0\"\u003e\r\n                    \u003ch6 class=\"fw-bold mb-3\"\u003eMenu\u003c/h6\u003e\r\n                    \u003cul class=\"list-unstyled\"\u003e\r\n                        \u003cli\u003e\u003ca href=\"#metodo\" class=\"footer-link small d-block mb-2\"\u003eO Mé