# ============================================================
# Mente Serena — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para .env e preencha os valores reais
# NUNCA faça commit do .env real no Git!
# ============================================================

# Configurações do Servidor
PORT=3000
FRONTEND_URL=https://seusite.com.br

# ============================================================
# Mercado Pago
# ============================================================
MP_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao-aqui
MP_WEBHOOK_SECRET=seu-webhook-secret-aqui

# ============================================================
# Banco de Dados MySQL
# Para Aiven Cloud: use o host, porta 13333 e DB_SSL=true
# Para local:       use localhost, porta 3306 e DB_SSL=false
# ============================================================
DB_HOST=mysql-XXXX.aivencloud.com
DB_PORT=13333
DB_USER=avnadmin
DB_PASSWORD=sua-senha-aqui
DB_NAME=defaultdb
DB_SSL=true
