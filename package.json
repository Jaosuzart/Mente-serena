{
  "name": "checkout-curso-api",
  "version": "1.0.0",
  "description": "Servidor Express para Checkout do Curso com Mercado Pago",
  "main": "server.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "pm2:start": "pm2 start src/app.js --name \"api-checkout\" --instances 1 --env production",
    "test": "node --test tests/*.test.js",
    "lint:home": "html-validate src/frontend/index.html && stylelint src/frontend/css/home.css",
    "test:integration": "npm run test:config && node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:config": "node scripts/check-test-environment.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.0.9",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "html-validate": "^11.16.1",
    "nodemon": "^3.1.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.142.0"
  },
  "author": "Engenheiro Sênior",
  "license": "ISC"
}
